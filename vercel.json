{
  "functions": {
    "api/turn.py": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "clarke-agent/**/*.md"
    }
  },
  "rewrites": [
    { "source": "/deal/:token", "destination": "/deal.html" }
  ],
  "headers": [
    {
      "source": "/deal.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/deal/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
